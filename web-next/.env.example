# Copy to .env.local and keep it out of Git. These values are SERVER-ONLY.
API_BASE_URL=http://localhost:8080
# Generate a 32-byte secret: openssl rand -base64 32
SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_BASE64
# Default is 60 seconds. Set to 600 only when deliberately reproducing refresh races.
REFRESH_MARGIN_SECONDS=60
