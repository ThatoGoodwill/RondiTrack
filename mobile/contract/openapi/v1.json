{
  "openapi": "3.1.1",
  "info": {
    "title": "RondiTrack.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "description": "Returns an access token in the body. The refresh token is set as an HttpOnly cookie.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/home": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "The signed-in member's home screen",
        "description": "One response covering every stokvel the caller belongs to: their role, the current cycle, what they paid, what they still owe (integer cents) and the next payout date (UTC). A caller in no stokvels gets an empty list.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stokvels/{stokvelId}/contributions": {
      "get": {
        "tags": [
          "StokvelContributions"
        ],
        "summary": "List a stokvel's contributions, paged",
        "parameters": [
          {
            "name": "stokvelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cycleId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfContributionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfContributionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfContributionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stokvels/{stokvelId}/cycles/{cycleId}/payout/order": {
      "get": {
        "tags": [
          "Payouts"
        ],
        "summary": "Get a cycle's rotation and payout order",
        "parameters": [
          {
            "name": "stokvelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cycleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutOrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/activity": {
      "get": {
        "tags": [
          "Activity"
        ],
        "summary": "Newest activity from the caller's stokvels, paged",
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfActivityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TokenResponse": {
        "required": [
          "accessToken",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HomeResponse": {
        "required": [
          "stokvels"
        ],
        "type": "object",
        "properties": {
          "stokvels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HomeStokvelResponse"
            }
          }
        }
      },
      "HomeStokvelResponse": {
        "type": "object",
        "required": [
          "stokvelId",
          "name",
          "role",
          "currentCycle",
          "arrearsCents",
          "nextPayoutDueUtc"
        ],
        "properties": {
          "stokvelId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "currentCycle": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HomeCycleResponse"
              }
            ]
          },
          "arrearsCents": {
            "type": "integer",
            "format": "int64"
          },
          "nextPayoutDueUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "HomeCycleResponse": {
        "type": "object",
        "required": [
          "id",
          "label",
          "paidCents",
          "owedCents",
          "status",
          "endsOn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string"
          },
          "paidCents": {
            "type": "integer",
            "format": "int64"
          },
          "owedCents": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "endsOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "ContributionResponse": {
        "required": [
          "id",
          "stokvelId",
          "userId",
          "contributionCycleId",
          "amount",
          "recordedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stokvelId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "contributionCycleId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PageResponseOfContributionResponse": {
        "required": [
          "items",
          "nextPageToken"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContributionResponse"
            }
          },
          "nextPageToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PayoutOrderResponse": {
        "type": "object",
        "required": [
          "stokvelId",
          "cycleId",
          "nextMemberId",
          "entries"
        ],
        "properties": {
          "stokvelId": {
            "type": "string",
            "format": "uuid"
          },
          "cycleId": {
            "type": "string",
            "format": "uuid"
          },
          "nextMemberId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayoutOrderEntryResponse"
            }
          }
        }
      },
      "PayoutOrderEntryResponse": {
        "type": "object",
        "required": [
          "memberId",
          "memberName",
          "position",
          "amountCents",
          "status",
          "paidOnUtc"
        ],
        "properties": {
          "memberId": {
            "type": "string",
            "format": "uuid"
          },
          "memberName": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "amountCents": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "paidOnUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ActivityResponse": {
        "type": "object",
        "required": [
          "id",
          "stokvelId",
          "kind",
          "occurredAt",
          "amountCents",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stokvelId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "amountCents": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "PageResponseOfActivityResponse": {
        "type": "object",
        "required": [
          "items",
          "nextPageToken"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityResponse"
            }
          },
          "nextPageToken": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
